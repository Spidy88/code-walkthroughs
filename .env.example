# Anthropic API key — unset this to test LLM-disabled degradation paths.
ANTHROPIC_API_KEY=

# Server HTTP port (default 4000).
CW_SERVER_PORT=4000

# Vite dev server port (default 5173).
CW_WEB_PORT=5173

# Pino log level (trace|debug|info|warn|error). Default: info.
CW_LOG_LEVEL=info

# Override storage location. Default: ~/.code-walkthrough
# CW_DATA_DIR=

# Permits integration tests to hit the real Anthropic API. Default: unset.
# CW_ALLOW_REAL_LLM=
